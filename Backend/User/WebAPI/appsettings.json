{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.Authentication": "Debug",
      "Microsoft.AspNetCore.Authorization": "Debug"
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    }
  },
  "Seq": {
    "ServerUrl": "",
    "ApiKey": "",
    "BufferBaseFilename": "/var/log/seq-buffer/log-buffer"
  },
  "OpenTelemetry": {
    "Otlp": {
      "Endpoint": ""
    },
    "SamplingRatio": 1.0
  },
  "Observability": {
    "TrustIncomingTraceParent": false
  },
  "AllowedHosts": "*"
}
